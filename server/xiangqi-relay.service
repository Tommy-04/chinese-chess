[Unit]
Description=Chinese Chess TCP Relay Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/xiangqi/server
ExecStart=/opt/xiangqi/server/relay_server 6818
Restart=on-failure
RestartSec=2
User=root
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
